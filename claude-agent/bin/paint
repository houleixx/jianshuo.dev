#!/usr/bin/env bash
# paint — 调本机 paint 服务（127.0.0.1:8788，即 paint.jianshuo.dev）出图。
# 文生图:  paint "提示词" 输出.jpg
# 改图:    paint "提示词" 输出.jpg --image 输入.jpg
# 选项:    --size WxH(默认1024x1024) --transparent --quality low|medium|high --format png|jpeg|webp --compression 0-100
# 格式不给就按输出文件扩展名定：.jpg/.jpeg→jpeg、.webp→webp、其余→png。
# jpeg/webp 不给 --compression 一律 80（2026-09-18 起书里的图统一 JPG q80，PNG 大 4~5 倍没有必要）。
# 成功时输出结果文件路径 + 公开 result_url；出图通常 1-3 分钟，脚本自轮询直到完成。
set -euo pipefail

API=${PAINT_API:-http://127.0.0.1:8788}
TOKEN=${PAINT_API_TOKEN:?PAINT_API_TOKEN not set}

PROMPT=${1:?usage: paint "prompt" out.jpg [--image in.jpg] [--size WxH] [--transparent] [--quality q] [--format f] [--compression n]}
OUT=${2:?output file required}
shift 2

SIZE=1024x1024 TRANSPARENT=false QUALITY="" FORMAT="" COMPRESSION="" IMAGE=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --image) IMAGE=$2; shift 2 ;;
    --size) SIZE=$2; shift 2 ;;
    --transparent) TRANSPARENT=true; shift ;;
    --quality) QUALITY=$2; shift 2 ;;
    --format) FORMAT=$2; shift 2 ;;
    --compression) COMPRESSION=$2; shift 2 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

if [[ -z $FORMAT ]]; then
  case ${OUT,,} in
    *.jpg|*.jpeg) FORMAT=jpeg ;;
    *.webp) FORMAT=webp ;;
    *) FORMAT=png ;;
  esac
fi
if [[ -z $COMPRESSION && $FORMAT != png ]]; then COMPRESSION=80; fi

BODY=$(node -e '
const fs = require("fs");
const [prompt, size, transparent, quality, format, compression, image] = process.argv.slice(1);
const b = { prompt, size };
if (transparent === "true") b.transparent = true;
if (quality) b.quality = quality;
if (format) b.format = format;
if (compression) b.compression = Number(compression);
if (image) b.image_b64 = fs.readFileSync(image).toString("base64");
process.stdout.write(JSON.stringify(b));
' "$PROMPT" "$SIZE" "$TRANSPARENT" "$QUALITY" "$FORMAT" "$COMPRESSION" "$IMAGE")

JOB_ID=$(printf '%s' "$BODY" | curl -sS -X POST "$API/api/jobs" \
  -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" \
  --data-binary @- | node -e '
let d = ""; process.stdin.on("data", c => d += c).on("end", () => {
  const j = JSON.parse(d);
  if (!j.job_id) { console.error(d); process.exit(1); }
  console.log(j.job_id);
});')
echo "job $JOB_ID submitted, waiting..." >&2

for _ in $(seq 1 144); do
  sleep 5
  STATE=$(curl -sS -H "Authorization: Bearer $TOKEN" "$API/api/jobs/$JOB_ID" | node -e '
let d = ""; process.stdin.on("data", c => d += c).on("end", () => {
  const j = JSON.parse(d);
  console.log([j.status, j.result_url ?? "", j.error ?? ""].join("\t"));
});')
  IFS=$'\t' read -r STATUS URL ERR <<<"$STATE"
  case $STATUS in
    done)
      curl -sS -o "$OUT" "$URL"
      echo "saved: $OUT"
      echo "result_url: $URL"
      exit 0 ;;
    failed)
      echo "paint job failed: $ERR" >&2
      exit 1 ;;
    *) echo "  $STATUS..." >&2 ;;
  esac
done
echo "timed out after 12 minutes (job $JOB_ID)" >&2
exit 1
